FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt pytest==8.3.4
COPY app ./app
COPY tests/test_cloud_integration.py ./tests/test_cloud_integration.py
CMD ["python", "-m", "pytest", "tests/test_cloud_integration.py", "-v", "--tb=short", "-o", "log_cli=true"]
