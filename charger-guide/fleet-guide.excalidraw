\n\nconnector — CCS2 plug\n\ncapacity_kwh — 40 when full\n\nkwh_per_km — 0.25 per km driven\n\nbattery_kwh — latest reading, 8\n\nroad_km — position on road, 0\n\nlast_sequence — last accepted event;\nolder or repeated numbers are skipped.","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"id (PK) — Van-A\n\nconnector — CCS2 plug\n\ncapacity_kwh — 40 when full\n\nkwh_per_km — 0.25 per km driven\n\nbattery_kwh — latest reading, 8\n\nroad_km — position on road, 0\n\nlast_sequence — last accepted event;\nolder or repeated numbers are skipped.","autoResize":true,"lineHeight":1.25},{"id":"fleet-31","type":"rectangle","x":424,"y":755,"width":405,"height":495,"angle":0,"strokeColor":"#193b39","backgroundColor":"#e0f4e9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":31,"version":1,"versionNonce":713,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},{"id":"fleet-32","type":"text","x":440,"y":769,"width":477.4,"height":27.5,"angle":0,"strokeColor":"#193b39","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":32,"version":1,"versionNonce":736,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"fontSize":22,"fontFamily":2,"text":"alerts  ·  one low-battery incident","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"alerts  ·  one low-battery incident","autoResize":true,"lineHeight":1.25},{"id":"fleet-33","type":"text","x":440,"y":810,"width":390.6,"height":292.5,"angle":0,"strokeColor":"#193b39","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":33,"version":1,"versionNonce":759,"isDeleted":false,"boundElements":null,"updated":1,"link":null