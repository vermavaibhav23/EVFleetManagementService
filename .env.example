APP_NAME=EV Fleet Charging Management
APP_ENV=development
API_V1_PREFIX=/api/v1

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ev_fleet

REDIS_URL=redis://localhost:6379/0

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=ev-fleet-api
KAFKA_TELEMETRY_TOPIC=vehicle.telemetry.v1
KAFKA_ALERTS_TOPIC=vehicle.alerts.v1
KAFKA_CONSUMER_GROUP=ev-fleet-api
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_USERNAME=
KAFKA_PASSWORD=

LOW_SOC_ALERT_THRESHOLD=20
RESERVE_RANGE_KM=15
CHARGE_SOON_MARGIN_KM=15
CHARGING_DEADLINE_BUFFER_MINUTES=20
SCHEDULER_SLOT_MINUTES=15
CHARGING_EFFICIENCY=0.92

