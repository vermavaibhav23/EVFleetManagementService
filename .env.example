APP_NAME=EV Fleet Charging Management
API_V1_PREFIX=/api/v1
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ev_fleet

# Optional external telemetry ingress. HTTP telemetry needs only MongoDB.
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TELEMETRY_TOPIC=vehicle.telemetry.v2
KAFKA_CONSUMER_GROUP=ev-fleet-v2
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
