APP_NAME=EV Fleet Charging Management
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql://fleet:fleet@localhost:5432/fleet
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ev_fleet_history
MONGO_HISTORY_DAYS=30

# Required Kafka transport. Configure reachable cloud services in Railway Variables.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TELEMETRY_TOPIC=vehicle.telemetry.v3
KAFKA_PLANNING_TOPIC=planning.requests.v3
KAFKA_GROUP_PREFIX=fleet-v3
KAFKA_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# Only if required by the broker (infrastructure credentials, not client API keys):
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_USERNAME=
# KAFKA_PASSWORD=
TELEMETRY_WORKERS=3
TELEMETRY_MAX_AGE_SECONDS=120
RUN_WORKERS=true
# Default embedded forwarder uses http://127.0.0.1:$PORT (default port 8000).
# For a separate cloud worker, set the FastAPI service URL:
# PROVIDER_API_URL=https://your-api.up.railway.app
