# Aiven PostgreSQL URI (never commit real credentials).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/defaultdb?sslmode=require
# Paste the project CA PEM into the deployment secret environment if required.
DATABASE_SSL_CA_PEM=
KAFKA_BOOTSTRAP_SERVERS=HOST:PORT
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=
KAFKA_SSL_CA_PEM=
KAFKA_TELEMETRY_TOPIC=vehicle.telemetry.v4
KAFKA_GROUP_PREFIX=fleet-interview-v4
KAFKA_AUTO_CREATE_TOPICS=false
RUN_WORKERS=true
DEMO_IDLE_SECONDS=300
TELEMETRY_HISTORY_DAYS=3
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
# Optional GenAI explanations; server-side secret, never exposed to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AI_REQUESTS_PER_MINUTE=3
AI_REQUESTS_PER_DAY=20
